
let {

    # Booleans:
    # --------------------------------------
    true = /_true_x./y. _true_x;
    false = /_false_x./y. y;
    not = /b. b false true;
    and = /a./b. a b false;
    or  = /a./b. a true b;
    xor = /a./b. a (not b) b;
    bools_are_equal = /a./b. not (xor a b);
    if_then_else = /x.x;


    # Fixed-point combinators:
    # --------------------------------------
    # Use it like: my_recursive_function = Y   /recurse./x. some expression that calls recurse(x2)
    # Use it like: my_recursive_function = S S /recurse./x. some expression that calls recurse(x2)
    Y = /f. (/x.f(x x)) (/x.f(x x));
    Y2 = /f. let{thing = /x.f(x x);}(thing thing); # Might memoize better than Y
    Z = /f. (/x.f(/v.x x v)) (/x.f(/v.x x v)); # Safe with eager evaluation
    S = /S./f. f (S S f); # Might memoize better than Y
    T = /T./f. f (/v.T T f v); # Safe with eager evaluation
    recursive = S S; # Our chosen default fixed-point combinator


    # Church numerals:
    # --------------------------------------
    cn_0 = /f./x. x;
    cn_1 = /f./x. f x;
    cn_succ = /n. /f./x. f(n f x);
    cn_pred = /n. /f./x. n (/g./h. h (g f)) (/u.x) (/z.z);
    cn_2 = cn_succ cn_1;
    cn_3 = cn_succ cn_2;
    cn_4 = cn_succ cn_3;
    cn_5 = cn_succ cn_4;
    cn_6 = cn_succ cn_5;
    cn_7 = cn_succ cn_6;
    cn_add  = /n./m. /f./x. n f (m f x);
    cn_sub  = /n./m. m cn_pred n;
    cn_mult = /n./m. /f. n (m f);
    cn_exp  = /n./m. m n;
    cn_is_zero = /n. /x./y. n (/z.y) x;
    cn_factorial = recursive /cn_factorial. /n. if_then_else (cn_is_zero n) cn_1 (cn_mult (cn_factorial (cn_pred n)) n );


    # Optional values:
    # --------------------------------------
    none =       /if_none./if_some. if_none;
    some = /val. /if_none./if_some. if_some val;
    nil = none; # Conventionally, we usually use nil for empty lists and none for empty options
    is_none = /opt. opt true /v.false;
    is_nil = is_none;


    # Pairs:
    # --------------------------------------
    pair = /a./b. /f. f a b;
    first = /p. p true;
    second = /p. p false;
    unpack = /f./p. p f; # Useful if you need a function of a pair: Partially apply unpack like (unpack /a./b. ...). Note that unpacking a pair can be done with just (mypair /a./b. ...).


    # Lists:  (A list is an optional pair)
    # --------------------------------------
    cons = /head./tail. some (pair head tail);
    head_of = /list./if_nil. list if_nil /p.first p;
    tail_of = /list. list nil /p.second p; # Returns the remainder of the list, i.e. everything except the head
    fold_from_left = recursive /fold_from_left. /list./start_val./reduce. list start_val (unpack /head./tail. fold_from_left tail (reduce head start_val) reduce);
    fold_from_right = recursive /fold_from_right. /list./start_val./reduce. list start_val (unpack /head./tail. reduce head (fold_from_right tail start_val reduce));
    last_of = /list./if_nil. fold_from_left list if_nil /v./s. v;
    reverse = /x.x; # TODO
    concat = /x.x; # TODO
    map = /x.x; # TODO
    flatten = /x.x; # TODO
    flat_map = /x.x; # TODO


    # Enums:
    # (For enums where more values may be added in the future, use a BNN instead, to avoid pain)
    # --------------------------------------
    e3a = /a./b./c. a;
    e3b = /a./b./c. b;
    e3c = /a./b./c. c;

    e4a = /a./b./c./d. a;
    e4b = /a./b./c./d. b;
    e4c = /a./b./c./d. c;
    e4d = /a./b./c./d. d;

    e5a = /a./b./c./d./e. a;
    e5b = /a./b./c./d./e. b;
    e5c = /a./b./c./d./e. c;
    e5d = /a./b./c./d./e. d;
    e5e = /a./b./c./d./e. e;


    # Tuples:  (Like pairs, but longer)
    # --------------------------------------
    tuple3 = /a./b./c.       /f. f a b c;     # Can use e3a-e3c as f if you just want to select one item
    tuple4 = /a./b./c./d.    /f. f a b c d;   # Can use e4a-e4d as f if you just want to select one item
    tuple5 = /a./b./c./d./e. /f. f a b c d e; # Can use e5a-e5e as f if you just want to select one item


    # Binary natural numbers:
    # (A BNN is a list of booleans, where the head is the least significant bit)
    # --------------------------------------
    bn_0 = nil;
    bn_1 = (cons true nil);
    bn_cons = /head./tail. if_then_else (and (not head) (is_nil tail)) nil (cons head tail); # Normalizes the result to nil if the remainder is nil and head is 0
    bn_is_normalized = /n. last_of n true; # A "normalized" BNN is where the most significant bit is 1
    bn_normalize_unnormalized = /n. fold_from_right n nil bn_cons;
    bn_normalize = /n. (bn_is_normalized n) n (bn_normalize_unnormalized n);
    bn_unnormalize = /n. fold_from_right n (cons false (cons false (cons false nil))) cons;
    incr = recursive /incr. /n. n bn_1 (unpack /head./tail. if_then_else head (bn_cons false (incr tail)) (bn_cons true tail));
    decr_normalized = recursive /decr_normalized. /n. n bn_0 (unpack /head./tail. if_then_else head (bn_cons false tail) (bn_cons true (decr_normalized tail))); # Requires n is normalized OR n > 0
    decr = /n. decr_normalized (bn_normalize n); # Note that (decr 0) is 0
    cn_to_bn = /n. n incr bn_0;
    is_zero = recursive /is_zero. /n. n true (unpack /head./tail. if_then_else head false (is_zero tail)); # Works even if n is not normalized
    compare = recursive /compare. /x./y. # Returns e3a if x < y, e3b if x == y, or e3c if x > y
        x (if_then_else (is_zero y) e3b e3a) (unpack /x_bit./x_tail.
            y (if_then_else (is_zero x) e3b e3c) (unpack /y_bit./y_tail.
                (compare x_tail y_tail)
                e3a                                               # compare tails returned e3a
                (if_then_else (bools_are_equal x_bit y_bit) e3b ( # compare tails returned e3b
                    if_then_else x_bit e3c e3a
                ))
                e3c                                               # compare tails returned e3c
            )
        );
    are_equal        = /x./y. (compare x y) false true  false;
    less_than        = /x./y. (compare x y) true  false false;
    less_or_equal    = /x./y. (compare x y) true  true  false;
    greater_than     = /x./y. (compare x y) false false true;
    greater_or_equal = /x./y. (compare x y) false true  true;
    add = recursive /add. /n./m.
        n m (unpack /n_bit./n_tail.
            m n (unpack /m_bit./m_tail.
                let {
                    result_bit = xor n_bit m_bit;
                    result_tail = add n_tail m_tail;
                    result_tail = if_then_else (and n_bit m_bit) (incr result_tail) result_tail;
                }(bn_cons result_bit result_tail)
            )
        );
    sub_unsafe = recursive /sub_unsafe. /n./m. # Requires n >= m. Does not require n or m to be normalized.
        n bn_0 (unpack /n_bit./n_tail.
            m n (unpack /m_bit./m_tail.
                let {
                    result_bit = xor n_bit m_bit;
                    result_tail = sub_unsafe n_tail m_tail;
                    result_tail = if_then_else (and (not n_bit) m_bit) (decr_normalized result_tail) result_tail;
                }(bn_cons result_bit result_tail)
            )
        );
    sub = /n./m. if_then_else (greater_than n m) (sub_unsafe n m) bn_0; # Returns 0 if n <= m. Does not require n or m to be normalized.
    mult = /x.x; # TODO
    factorial = /x.x; # TODO
    divide = /x.x; # TODO
    apply_n_times = /x.x; # TODO
    bn_to_cn = /x.x; # TODO


    # Lists, continued:
    # --------------------------------------
    len = /x.x; # TODO

}
( {INSERT_WRAPPED_CODE} )

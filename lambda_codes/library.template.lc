
## TODO: Highest priority
    ## Optional values
        ## nil
        ## none
        ## some
        ## is_nil
        ## is_none
    ## Pairs
        ## pair
        ## first
        ## second
    ## Lists
        ## cons
        ## head
        ## tail
    ## Binary natural numbers
        ## bn_0
        ## incr
        ## decr
        ## cn_to_bn

let {

    # Booleans:
    # --------------------------------------
    true = /_true_x./y. _true_x;
    false = /_false_x./y. y;
    not = /b. b false true;
    and = /x.x; # TODO
    or = /x.x; # TODO
    if_then_else = /x.x;


    # Fixed-point combinators:
    # --------------------------------------
    # Use it like: my_recursive_function = Y   /recurse./x. some expression that calls recurse(x2)
    # Use it like: my_recursive_function = S S /recurse./x. some expression that calls recurse(x2)
    Y = /f. (/x.f(x x)) (/x.f(x x));
    Y2 = /f. let{thing = /x.f(x x);}(thing thing); # Might memoize better than Y
    Z = /f. (/x.f(/v.x x v)) (/x.f(/v.x x v)); # Safe with eager evaluation
    S = /S./f. f (S S f); # Might memoize better than Y
    T = /T./f. f (/v.T T f v); # Safe with eager evaluation


    # Church numerals:
    # --------------------------------------
    cn_0 = /f./x. x;
    cn_1 = /f./x. f x;
    cn_succ = /n. /f./x. f(n f x);
    cn_pred = /n. /f./x. n (/g./h. h (g f)) (/u.x) (/z.z); # pred de Kleene
    cn_2 = cn_succ cn_1;
    cn_3 = cn_succ cn_2;
    cn_4 = cn_succ cn_3;
    cn_5 = cn_succ cn_4;
    cn_6 = cn_succ cn_5;
    cn_7 = cn_succ cn_6;
    cn_add  = /n./m. /f./x. n f (m f x);
    cn_sub  = /n./m. m cn_pred n;
    cn_mult = /n./m. /f. n (m f);
    cn_exp  = /n./m. m n;
    cn_is_zero = /n. /x./y. n (/z.y) x;
    cn_fact_old = /cn_fact. /n. if_then_else (cn_is_zero n) cn_1 (cn_mult (cn_fact cn_fact (cn_pred n)) n );
    cn_fact = Y /cn_fact. /n. if_then_else (cn_is_zero n) cn_1 (cn_mult (cn_fact (cn_pred n)) n );


    # Optional values:
    # --------------------------------------
    none =       /if_none./if_some. if_none;
    some = /val. /if_none./if_some. if_some val;
    nil = none; # Conventionally, we usually use nil for empty lists and none for empty options
    is_none = /opt. opt true /v.false;
    is_nil = is_none;


    # Pairs:
    # --------------------------------------
    pair = /x.x; # TODO
    first = /x.x; # TODO
    second = /x.x; # TODO


    # Lists:  (A list is an optional pair)
    # --------------------------------------
    cons = /x.x; # TODO
    head = /x.x; # TODO
    tail = /x.x; # TODO
    fold_from_left = /x.x; # TODO
    fold_from_right = /x.x; # TODO
    reverse = /x.x; # TODO
    concat = /x.x; # TODO
    map = /x.x; # TODO
    flatten = /x.x; # TODO
    flat_map = /x.x; # TODO


    # Enums:
    # (For enums where more values may be added in the future, use a BNN instead, to avoid pain)
    # --------------------------------------
    e3a = /a./b./c. a;
    e3b = /a./b./c. b;
    e3c = /a./b./c. c;

    e4a = /a./b./c./d. a;
    e4b = /a./b./c./d. b;
    e4c = /a./b./c./d. c;
    e4d = /a./b./c./d. d;

    e5a = /a./b./c./d./e. a;
    e5b = /a./b./c./d./e. b;
    e5c = /a./b./c./d./e. c;
    e5d = /a./b./c./d./e. d;
    e5e = /a./b./c./d./e. e;


    # Tuples:  (Like pairs, but longer)
    # --------------------------------------
    tuple3 = /a./b./c.       /selector. selector a b c;     # Use e3a-e3c as selector
    tuple4 = /a./b./c./d.    /selector. selector a b c d;   # Use e4a-e4d as selector
    tuple5 = /a./b./c./d./e. /selector. selector a b c d e; # Use e5a-e5e as selector


    # Binary natural numbers:
    # (A BNN is a list of booleans, where the head is the least significant bit)
    # --------------------------------------
    bn_0 = nil;
    incr = /x.x; # TODO
    decr = /x.x; # TODO
    cn_to_bn = /x.x; # TODO
    is_zero = /x.x; # TODO
    bn_cons = /x.x; # TODO # Normalizes the result to nil if the remainder is nil and head is 0
    bn_normalize = /x.x; # TODO # A "normalized" BNN is where the most significant bit is 1
    add = /x.x; # TODO
    sub = /x.x; # TODO
    mult = /x.x; # TODO
    divide = /x.x; # TODO
    apply_n_times = /x.x; # TODO
    bn_to_cn = /x.x; # TODO
    compare = /x.x; # TODO # Returns e3a if x < y, e3b if x == y, or e3c if x > y
    are_equal = /x.x; # TODO
    less_than = /x.x; # TODO
    less_or_equal = /x.x; # TODO
    greater_than = /x.x; # TODO
    greater_or_equal = /x.x; # TODO


    # Lists, continued:
    # --------------------------------------
    len = /x.x; # TODO

}
( {INSERT_WRAPPED_CODE} )
